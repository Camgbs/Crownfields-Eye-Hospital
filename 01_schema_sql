    pt.last_name,
    a.appointment_id,
    a.appointment_date,
    f.follow_up_id,
    f.due_date,
    f.priority,
    f.status
FROM patient pt
LEFT JOIN appointment a ON a.patient_id = pt.patient_id
LEFT JOIN follow_up_plan f ON f.appointment_id = a.appointment_id
WHERE pt.patient_id BETWEEN 'SY001' AND 'SY010'
ORDER BY pt.patient_id, a.appointment_id;
 


-- 01d_tests
-- Crownfield Eye Hospital | Part B | Shared MySQL 8.0.16+ test file
-- Run 01_schema.sql, 01b_appendix_data.sql and 01c_synthetic_data.sql first.
-- Use a fresh connection in MySQL Workbench. Execute the entire file.
-- Requires permission to create routines and temporary tables. Use InnoDB.
-- Test rows are rolled back. Generated numeric IDs may have gaps afterwards.
USE crownfield_eye_hospital;

DROP TEMPORARY TABLE IF EXISTS part_b_log;
CREATE TEMPORARY TABLE part_b_log (
    test_id CHAR(3) PRIMARY KEY,
    lead_name VARCHAR(12),
    expected_result VARCHAR(120),
    actual_result VARCHAR(400),
    verdict VARCHAR(4)
) ENGINE = MEMORY;  -- Keep the session's evidence after the data rollback.

DROP PROCEDURE IF EXISTS part_b_01d_run_tests;
DELIMITER $$
CREATE PROCEDURE part_b_01d_run_tests()
BEGIN
    DECLARE n INT DEFAULT 0;
    DECLARE err INT DEFAULT 0;
    DECLARE msg VARCHAR(300) DEFAULT '';
    DECLARE appt, plan_id, doctor, site_id, dx INT UNSIGNED;
    DECLARE old_status, new_status VARCHAR(20);
    DECLARE links_before, links_after, parents_after INT;
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    START TRANSACTION;

    -- T01 | Saima | Check the tables built by the schema file.
    SELECT COUNT(*) INTO n FROM information_schema.tables
    WHERE table_schema = DATABASE() AND table_type = 'BASE TABLE'
      AND table_name IN ('patient','clinic','specialty','clinician','appointment',
          'diagnosis','appointment_diagnosis','medicine','prescription',
          'prescription_item','follow_up_plan');
    INSERT INTO part_b_log VALUES ('T01','Saima','11 required tables',
        CONCAT(n,' required tables found'), IF(n=11,'PASS','FAIL'));
    IF n <> 11 THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='T01 failed. Run the complete schema first.';
    END IF;

    -- Reserve two unused IDs: one valid patient and one missing parent.
    IF EXISTS (SELECT 1 FROM patient WHERE patient_id IN ('BT_VALID','BT_MISSING')) THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Test IDs already exist. Choose two unused IDs in this file.';
    END IF;
    SELECT MIN(clinician_id) INTO doctor FROM clinician;
    SELECT MIN(clinic_id) INTO site_id FROM clinic;
    SELECT MIN(diagnosis_id) INTO dx FROM diagnosis;
    IF doctor IS NULL OR site_id IS NULL OR dx IS NULL THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Load clinician, clinic and diagnosis data first.';
    END IF;
    IF EXISTS (SELECT 1 FROM appointment WHERE clinician_id=doctor
               AND appointment_date='2099-01-15' AND appointment_time IN ('09:00','09:30')) THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Test slots already used. Choose another test date throughout.';
    END IF;

    -- T02 | Saima | Insert one valid patient and read it back.
    INSERT INTO patient (patient_id, first_name, last_name, postcode)
    VALUES ('BT_VALID','Test','Patient','M1 1AA');
    SELECT COUNT(*) INTO n FROM patient WHERE patient_id='BT_VALID';
    INSERT INTO part_b_log VALUES ('T02','Saima','1 matching patient',
        CONCAT(n,' matching patient(s)'), IF(n=1,'PASS','FAIL'));

    -- T03 | Saima | Reject duplicate patient ID
    SAVEPOINT negative_case;
    SET err=0, msg='Statement accepted';
    BEGIN
        DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
            GET DIAGNOSTICS CONDITION 1 err=MYSQL_ERRNO, msg=MESSAGE_TEXT;
        INSERT INTO patient (patient_id,first_name,last_name,postcode)
        VALUES ('BT_VALID','Second','Patient','M1 1AB');
    END;
    ROLLBACK TO SAVEPOINT negative_case;
    INSERT INTO part_b_log VALUES ('T03','Saima','Reject duplicate patient ID (error 1062)',
        CONCAT(err,' | ',msg), IF(err=1062,'PASS','FAIL'));

    -- T04 | Rifat | Reject duplicate specialty name
    SAVEPOINT negative_case;
    SET err=0, msg='Statement accepted';
    BEGIN
        DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
            GET DIAGNOSTICS CONDITION 1 err=MYSQL_ERRNO, msg=MESSAGE_TEXT;
        INSERT INTO specialty (specialty_name)
        SELECT specialty_name FROM specialty ORDER BY specialty_id LIMIT 1;
    END;
    ROLLBACK TO SAVEPOINT negative_case;
    INSERT INTO part_b_log VALUES ('T04','Partner','Reject duplicate specialty name (error 1062)',
        CONCAT(err,' | ',msg), IF(err=1062,'PASS','FAIL'));

    -- T05 | Rifat | Reject missing patient
    SAVEPOINT negative_case;
    SET err=0, msg='Statement accepted';
    BEGIN
        DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
            GET DIAGNOSTICS CONDITION 1 err=MYSQL_ERRNO, msg=MESSAGE_TEXT;
        INSERT INTO appointment (patient_id,clinician_id,clinic_id,appointment_date,appointment_time)
        VALUES ('BT_MISSING',doctor,site_id,'2099-01-15','09:30');
    END;
    ROLLBACK TO SAVEPOINT negative_case;
    INSERT INTO part_b_log VALUES ('T05','Partner','Reject missing patient (error 1452)',
        CONCAT(err,' | ',msg), IF(err=1452 AND LOCATE('fk_appointment_patient',msg)>0,'PASS','FAIL'));

    -- Create one valid appointment for the remaining tests.
    INSERT INTO appointment (patient_id,clinician_id,clinic_id,appointment_date,appointment_time)
    VALUES ('BT_VALID',doctor,site_id,'2099-01-15','09:00');
    SET appt=LAST_INSERT_ID();

    -- T06 | Rifat | Reject double-booked clinician
    SAVEPOINT negative_case;
    SET err=0, msg='Statement accepted';
    BEGIN
        DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
            GET DIAGNOSTICS CONDITION 1 err=MYSQL_ERRNO, msg=MESSAGE_TEXT;
        INSERT INTO appointment (patient_id,clinician_id,clinic_id,appointment_date,appointment_time)
        VALUES ('BT_VALID',doctor,site_id,'2099-01-15','09:00');
    END;
    ROLLBACK TO SAVEPOINT negative_case;
    INSERT INTO part_b_log VALUES ('T06','Partner','Reject double-booked clinician (error 1062)',
        CONCAT(err,' | ',msg), IF(err=1062 AND LOCATE('uq_clinician_timeslot',msg)>0,'PASS','FAIL'));

    -- T07 | Saima | Reject invalid priority Critical
    SAVEPOINT negative_case;
    SET err=0, msg='Statement accepted';
    BEGIN
        DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
            GET DIAGNOSTICS CONDITION 1 err=MYSQL_ERRNO, msg=MESSAGE_TEXT;
        INSERT INTO follow_up_plan (appointment_id,due_date,priority)
        VALUES (appt,'2099-02-15','Critical');
    END;
    ROLLBACK TO SAVEPOINT negative_case;
    INSERT INTO part_b_log VALUES ('T07','Saima','Reject invalid priority Critical (error 3819)',
        CONCAT(err,' | ',msg), IF(err=3819 AND LOCATE('chk_followup_priority',msg)>0,'PASS','FAIL'));

    -- T08 | Saima | Omit status to test its default, then change one row.
    INSERT INTO follow_up_plan (appointment_id,due_date,priority)
    VALUES (appt,'2099-02-15','Routine');
    SET plan_id=LAST_INSERT_ID();
    SELECT status INTO old_status FROM follow_up_plan WHERE follow_up_id=plan_id;
    UPDATE follow_up_plan SET status='Completed' WHERE follow_up_id=plan_id;
    SET n=ROW_COUNT();
    SELECT status INTO new_status FROM follow_up_plan WHERE follow_up_id=plan_id;
    INSERT INTO part_b_log VALUES ('T08','Saima','Pending to Completed, exactly 1 row',
        CONCAT(old_status,' -> ',new_status,', changed rows = ',n),
        IF(old_status='Pending' AND new_status='Completed' AND n=1,'PASS','FAIL'));

    -- T09 | Rifat | Delete only the test appointment-diagnosis link.
    INSERT INTO appointment_diagnosis (appointment_id,diagnosis_id) VALUES (appt,dx);
    SELECT COUNT(*) INTO links_before FROM appointment_diagnosis
    WHERE appointment_id=appt AND diagnosis_id=dx;
    DELETE FROM appointment_diagnosis WHERE appointment_id=appt AND diagnosis_id=dx;
    SET n=ROW_COUNT();
    SELECT COUNT(*) INTO links_after FROM appointment_diagnosis
    WHERE appointment_id=appt AND diagnosis_id=dx;
    SELECT (SELECT COUNT(*) FROM appointment WHERE appointment_id=appt)
         + (SELECT COUNT(*) FROM diagnosis WHERE diagnosis_id=dx) INTO parents_after;
    INSERT INTO part_b_log VALUES ('T09','Partner','Link count 1 to 0, both parents remain',
        CONCAT('Links ',links_before,' -> ',links_after,', deleted = ',n,', parents = ',parents_after),
        IF(links_before=1 AND links_after=0 AND n=1 AND parents_after=2,'PASS','FAIL'));

    -- T10 | Rifat | Protect patient with an appointment
    SAVEPOINT negative_case;
    SET err=0, msg='Statement accepted';
    BEGIN
        DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
            GET DIAGNOSTICS CONDITION 1 err=MYSQL_ERRNO, msg=MESSAGE_TEXT;
        DELETE FROM patient WHERE patient_id='BT_VALID';
    END;
    ROLLBACK TO SAVEPOINT negative_case;
    INSERT INTO part_b_log VALUES ('T10','Partner','Protect patient with an appointment (error 1451)',
        CONCAT(err,' | ',msg), IF(err=1451 AND LOCATE('fk_appointment_patient',msg)>0,'PASS','FAIL'));

    ROLLBACK;
END$$
DELIMITER ;

CALL part_b_01d_run_tests();
DROP PROCEDURE part_b_01d_run_tests;

