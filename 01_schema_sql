CREATE DATABASE IF NOT EXISTS crownfield_eye_hospital; -- 01_schema.sql file.

USE crownfield_eye_hospital;


CREATE TABLE patient (
    patient_id VARCHAR(10) PRIMARY KEY,
    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    postcode VARCHAR(10) NOT NULL
);
SELECT *FROM patient;


CREATE TABLE specialty (
    specialty_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    specialty_name VARCHAR(100) NOT NULL UNIQUE
);

SELECT *FROM specialty;

CREATE TABLE clinic (
    clinic_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    clinic_name VARCHAR(100) NOT NULL UNIQUE
);

SELECT *FROM clinic;


CREATE TABLE clinician (
    clinician_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    specialty_id INT UNSIGNED NOT NULL,

    CONSTRAINT fk_clinician_specialty
        FOREIGN KEY (specialty_id)
        REFERENCES specialty(specialty_id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);

SELECT *FROM clinician;

CREATE TABLE appointment (
    appointment_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    patient_id VARCHAR(10) NOT NULL,
    clinician_id INT UNSIGNED NOT NULL,
    clinic_id INT UNSIGNED NOT NULL,
    appointment_date DATE NOT NULL,
    appointment_time TIME NOT NULL,
    notes VARCHAR(255),

    CONSTRAINT fk_appointment_patient
        FOREIGN KEY (patient_id)
        REFERENCES patient(patient_id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT fk_appointment_clinician
        FOREIGN KEY (clinician_id)
        REFERENCES clinician(clinician_id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT fk_appointment_clinic
        FOREIGN KEY (clinic_id)
        REFERENCES clinic(clinic_id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);

SELECT *FROM appointment;

