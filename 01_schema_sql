-- Diagnosis TABLE

CREATE TABLE diagnosis (
    diagnosis_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    diagnosis_name VARCHAR(150) NOT NULL UNIQUE
);


SELECT *FROM diagnosis;

 -- AppointmentDiagnosis table
CREATE TABLE appointment_diagnosis (
    appointment_id INT UNSIGNED NOT NULL,
    diagnosis_id INT UNSIGNED NOT NULL,

    PRIMARY KEY (appointment_id, diagnosis_id),

    CONSTRAINT fk_ad_appointment
        FOREIGN KEY (appointment_id)
        REFERENCES appointment(appointment_id)
        ON DELETE CASCADE,

    CONSTRAINT fk_ad_diagnosis
        FOREIGN KEY (diagnosis_id)
        REFERENCES diagnosis(diagnosis_id)
        ON DELETE RESTRICT
);

SELECT *FROM appointment_diagnosis;

-- Medicine table
CREATE TABLE medicine (
    medicine_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    medicine_name VARCHAR(150) NOT NULL UNIQUE
);

SELECT *FROM medicine;

-- Prescription table
CREATE TABLE prescription (
    prescription_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    appointment_id INT UNSIGNED NOT NULL,

    CONSTRAINT fk_prescription_appointment
        FOREIGN KEY (appointment_id)
        REFERENCES appointment(appointment_id)
        ON DELETE CASCADE
);

SELECT *FROM prescription;

-- PrescriptionItem table
CREATE TABLE prescription_item (
    prescription_id INT UNSIGNED NOT NULL,
    medicine_id INT UNSIGNED NOT NULL,

    dose VARCHAR(50),
    route VARCHAR(50),
    frequency VARCHAR(50),
    duration_text VARCHAR(50),

    PRIMARY KEY (prescription_id, medicine_id),

    CONSTRAINT fk_pi_prescription
        FOREIGN KEY (prescription_id)
        REFERENCES prescription(prescription_id)
        ON DELETE CASCADE,

    CONSTRAINT fk_pi_medicine
        FOREIGN KEY (medicine_id)
        REFERENCES medicine(medicine_id)
        ON DELETE RESTRICT,

    CONSTRAINT chk_regimen_complete
        CHECK (
            (
                dose IS NULL
                AND route IS NULL
                AND frequency IS NULL
                AND duration_text IS NULL
            )
            OR
            (
                dose IS NOT NULL
                AND route IS NOT NULL
                AND frequency IS NOT NULL
                AND duration_text IS NOT NULL
            )
        )
);

SELECT *FROM prescription_item;

-- FollowUpPlan table
CREATE TABLE follow_up_plan (
    follow_up_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    appointment_id INT UNSIGNED NOT NULL UNIQUE,
    due_date DATE NOT NULL,
    priority VARCHAR(20) NOT NULL,
    status VARCHAR(20) NOT NULL DEFAULT 'Pending',

    CONSTRAINT fk_followup_appointment
        FOREIGN KEY (appointment_id)
        REFERENCES appointment(appointment_id)
        ON DELETE CASCADE,

    CONSTRAINT chk_followup_priority
        CHECK (priority IN ('Routine', 'High', 'Urgent')),

    CONSTRAINT chk_followup_status
        CHECK (status IN ('Pending', 'Scheduled', 'Completed', 'Cancelled'))
);

SELECT *FROM follow_up_plan;

